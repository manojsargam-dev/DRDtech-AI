<!DOCTYPE html>
  <html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Reset Your Password</title>
  </head>
  <body style="margin:0;padding:0;background:#f1f5f9;font-family:'Segoe UI',Arial,sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:40px 16px;">
      <tr>
        <td align="center">
          <table width="100%" cellpadding="0" cellspacing="0" style="max-width:520px;background:#ffffff;border-radius:20px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.07);">
            <tr>
              <td style="background:#869ca3;padding:32px 40px;text-align:center;">
                <span style="color:#ffffff;font-size:22px;font-weight:700;">DrDTech AI</span>
              </td>
            </tr>
            <tr>
              <td style="padding:40px 40px 32px;">
                <h1 style="margin:0 0 8px;font-size:22px;font-weight:700;color:#0f172a;">Reset Your Password</h1>
                <p style="margin:0 0 24px;font-size:14px;color:#64748b;line-height:1.7;">
                  Enter your new password below. This link will expire in <strong>1 hour</strong>.
                </p>

                <!-- Reset form -->
                <form method="POST" action="<%=resetUrl%>">
                  <input type="password" name="password" placeholder="New password" required
                         style="padding:10px;width:100%;margin-bottom:16px;border:1px solid #ccc;border-radius:8px;" />
                  <button type="submit"
                          style="background:#869ca3;color:#fff;padding:12px 24px;border:none;border-radius:8px;font-weight:600;">
                    Reset Password →
                  </button>
                </form>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
  </html>
  